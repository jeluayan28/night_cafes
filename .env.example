# Copy to .env.local (git-ignored). Never commit real values.

# Public: safe in the browser. Protected by RLS (read-only on public.cafes).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private: server only. NEVER prefix with NEXT_PUBLIC_ and never import from a client component.
